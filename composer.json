{
    "name": "communiqate/communiqate-laravel",
    "description": "Laravel mail, notifications, facade and webhook integration for CommuniQate Workspaces.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.3 <8.7",
        "communiqate/communiqate-php": "^0.1.0@dev",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/framework": "^12.0 || ^13.0",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "repositories": {
        "communiqate-php": {
            "type": "path",
            "url": "../communiqate-php",
            "options": {
                "symlink": true,
                "versions": {
                    "communiqate/communiqate-php": "dev-main"
                }
            }
        }
    },
    "autoload": {
        "psr-4": {
            "CommuniQate\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CommuniQate\\Laravel\\CommuniQateServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    },
    "config": {
        "sort-packages": true
    }
}
